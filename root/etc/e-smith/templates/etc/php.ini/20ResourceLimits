max_execution_time                     = {
    my $et = $phpcur->prop(MaxExecutionTime) || $php{MaxExecutionTime} || "30";
    $OUT .= "$et";
}
max_input_time                         = {
    my $it = $phpcur->prop(MaxInputTime) || $php{MaxInputTime} || "60";
    $OUT .= "$it";
}
memory_limit                           = {
    my $ml = $phpcur->prop(MemoryLimit) || $php{MemoryLimit} || "128M";
    $OUT .= "$ml";
}
