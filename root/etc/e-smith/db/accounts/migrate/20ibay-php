       my %old2new = (
                    UpMaxFileSize        => "UploadMaxFilesize",
                    PHPUploadMaxFilesize => "UploadMaxFilesize",
                    PHPPostMaxSize       => "PostMaxSize",
                    PHPMaxExecutionTime  => "MaxExecutionTime",
